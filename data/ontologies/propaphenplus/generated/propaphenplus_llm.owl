    <ns1:argument2 rdf:resource="http://www.semanticweb.org/alencga1/ontologies/2023/2/PhenOWL/t1"/>
    <ns1:propertyPredicate rdf:resource="http://www.w3.org/2006/time#hasBeginning"/>
