    <rdfs:comment xml:lang="en">Identifies the quality type (a gufo:EndurantType subclassing gufo:Quality) whose value is attributed in the gufo:QualityValueAttributionSituation.</rdfs:comment>
    <rdfs:label xml:lang="en">concernsQualityType</rdfs:label>
    <rdfs:range rdf:resource="http://purl.org/nemo/gufo#EndurantType"/>
  </rdf:Description>
