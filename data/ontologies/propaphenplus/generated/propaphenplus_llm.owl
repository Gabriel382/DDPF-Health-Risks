    <rdf:type rdf:resource="http://www.w3.org/2006/time#TemporalUnit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <time:seconds rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</time:seconds>
    <time:years rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</time:years>
