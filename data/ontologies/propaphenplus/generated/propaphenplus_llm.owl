    <ns1:argument1 rdf:resource="http://www.semanticweb.org/alencga1/ontologies/2023/2/PhenOWL/SO1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/seas/hasSubSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/seas/subSystemOf"/>
    <rdfs:label xml:lang="en">has sub system</rdfs:label>
