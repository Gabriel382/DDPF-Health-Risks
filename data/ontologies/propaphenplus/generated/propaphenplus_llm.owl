  <rdf:Description rdf:about="https://w3id.org/def/propaphen#fromPhenomenon">
    <rdfs:range rdf:resource="https://w3id.org/def/propaphen#Phenomenon"/>
    <rdfs:comment>Identifies the phen:Phenomenon that gives the occurrence phen:PhenomenonOccurrence.


I.e. A phen:PhenomenonOccurence "Occurence of a Hurricane in Paris" is an occurrence of the phen:Phenomenon "Hurricane".</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/propaphen#PhenomenonOccurrence"/>
    <rdfs:label>fromPhenomenon</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N46a962f53c1e47b680a41788ff9eaddf">
    <rdf:first rdf:resource="http://purl.org/nemo/gufo#ExtrinsicMode"/>
