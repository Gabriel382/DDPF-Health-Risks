  <rdf:Description rdf:about="http://purl.org/nemo/gufo#emergesFrom">
    <rdfs:comment>A gufo:Event is restricted to an area and an interval, both being conteined in a convex spatio-temporal region. In other words, a gufo;Events emerges from within a gufo:Scene.

(i.e. "Lebron James becoming NBA's all-time top scorer" gufo:Event hapened in the "7th February, 2023 in Crypto.com Arena" gufo:Scene.)</rdfs:comment>
    <rdfs:range rdf:resource="http://purl.org/nemo/gufo#Scene"/>
    <rdfs:domain rdf:resource="http://purl.org/nemo/gufo#Event"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>emergesFrom</rdfs:label>
  </rdf:Description>
