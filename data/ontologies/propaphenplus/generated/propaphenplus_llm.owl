  <rdf:Description rdf:about="http://purl.org/nemo/gufo#Relator">
    <rdfs:comment xml:lang="en">A gufo:ExtrinsicAspect that connects (involves, mediates) two or more concrete individuals. Relators are reified relationships composed of reciprocal extrinsic modes.

Examples of relators include John and Mary's marriage (composed of John's obligations towards Mary in the scope of the marriage, Mary's reciprocal claims, Mary's obligations towards John, John's reciprocal claims), Mary's employment contract at Nasa, a covalent bond between two atoms.</rdfs:comment>
    <rdfs:label xml:lang="en">Relator</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#ExtrinsicAspect"/>
    <rdfs:subClassOf rdf:nodeID="N24ab57c8956a40e8818fe176318fdb48"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/nemo/gufo#mediates"/>
  </rdf:Description>
