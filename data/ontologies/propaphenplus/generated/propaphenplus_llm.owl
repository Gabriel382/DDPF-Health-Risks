  <rdf:Description rdf:about="http://purl.org/nemo/gufo#standsInQualifiedAttribution">
    <rdfs:comment xml:lang="en">Identifies a gufo:QualityValueAttributionSituation in which the endurant stands. The identified gufo:QualityValueAttributionSituation is then used with the gufo:concernsQualityValue data property or the gufo:concernsReifiedQualityValue object property to indicate a quality value attributed to the gufo:Endurant standing in the situation. This forms a pattern to represent that quality values may differ in different situations.</rdfs:comment>
    <rdfs:label xml:lang="en">standsInQualifiedAttribution</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.org/nemo/gufo#Endurant"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#standsIn"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://purl.org/nemo/gufo#QualityValueAttributionSituation"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/nemo/gufo#QualityValueAttributionSituation"/>
  </rdf:Description>
