  <rdf:Description rdf:about="https://w3id.org/def/propaphen#hasPresence">
    <owl:inverseOf rdf:resource="https://w3id.org/def/propaphen#presenceOf"/>
    <rdfs:range rdf:resource="https://w3id.org/def/propaphen#Presence"/>
    <rdfs:comment>Relates an instance of gufo:Individual/entity to its spatiotemporal presence.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Has Presence</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.org/nemo/gufo#Entity"/>
  </rdf:Description>
