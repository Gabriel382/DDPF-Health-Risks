# Copy this file to .env in the repository root. Never commit .env.
# Valid values: ollama | openrouter
LLM_PROVIDER=ollama

# Ollama: install + start Ollama, then pull your chosen model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# OpenRouter: put your real private key ONLY in your local .env.
# No key is required for Ollama.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# LiteLLM common settings
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=120
STORYFOREST_TOP_K=8
STORYFOREST_DB=outputs/storyforest/stories.sqlite3

# Optional, only used when auditing a restored Neo4j snapshot
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional GATE Java/GAPP pipeline (needed only for headless Detection)
GATE_HOME=
GATE_PIPELINE_PATH=
